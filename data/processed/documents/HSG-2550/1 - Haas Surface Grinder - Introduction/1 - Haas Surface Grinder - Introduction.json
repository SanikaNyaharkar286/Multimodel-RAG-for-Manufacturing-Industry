    {
      "unit_id": "c92dfad5ae0ac9e6-p1-b3-unit",
      "kind": "text",
      "text": "This operator’s manual supplement describes\nthe unique features and functions of the Haas\nSurface Grinder machines.",
      "source_element_id": "c92dfad5ae0ac9e6-p1-b3",
      "source_element_type": "paragraph",
      "document_id": "c92dfad5ae0ac9e6",
      "source_filename": "1 - Haas Surface Grinder - Introduction.pdf",
      "page_index": 0,
      "page_number": 1,
      "printed_page_number": null,
      "bbox": [
        315.3627624511719,
        144.21328735351562,
        484.4029235839844,
        175.18820190429688
      ],
      "section_context": "Overview",
      "related_table_ids": []
    },
    {
      "unit_id": "c92dfad5ae0ac9e6-p1-b4-unit",
      "kind": "text",
      "text": "Specific details about the Haas Surface\nGrinder itself, including information that is\nbeyond the scope of this document, can be\nfound at www.HaasCNC.com.",
