GOOGLE_CLOUD_PROJECT=market-lens-506611
GCS_BUCKET_NAME=market-lens-506611-manufacturing-rag
BQ_DATASET=manufacturing_rag_dev
BQ_LOCATION=US
DOCUMENT_AI_PROJECT=market-lens-506611
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
DOCUMENT_AI_PROCESSOR_VERSION=your-tested-processor-version
BIGQUERY_QR_LINKS_TABLE=document_qr_links
AUTH_ENABLED=false
FIREBASE_PROJECT=market-lens-506611
COMPANY_ID=COMPANY_ID
COMPANY_NAME=COMPANY_NAME
FIRESTORE_DATABASE_ID=manufacturing-agent
# Maintenance reports use this Firestore database. Chat backups are optional.
CHAT_SESSION_CHECKPOINTS_ENABLED=false
# With chat backups off, live chats end on backend restart; saved reports remain.
# Short cache for approval-profile reads. Token revocation is still checked on every request.
AUTH_PROFILE_CACHE_TTL_SECONDS=10
ALLOWED_EMAIL_DOMAINS=example.com
ADMIN_EMAILS=admin@example.com
# New registration notifications. Recipients do not gain administrator privileges.
ADMIN_NOTIFICATION_EMAIL=admin@your-company.com
# Report submissions: comma-separated recipients; falls back to the address above.
# Recipients do not gain admin access. Start the durable email worker separately.
ADMIN_NOTIFICATION_EMAILS=
# Total MIME message budget, including base64 PDF overhead (default 20 MiB).
REPORT_EMAIL_MAX_MESSAGE_BYTES=20971520
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-sender-email@gmail.com
SMTP_FROM_NAME=Manufacturing Equipment Copilot
SMTP_USE_TLS=true
# Set to the public frontend URL reachable from the administrator's device.
APPROVAL_PORTAL_URL=http://localhost:5173
AGENT_MODEL=gemini-3.5-flash
PLANNER_MODEL=gemini-3.5-flash-lite
FINAL_LITE_MODEL=gemini-3.5-flash-lite
MODEL_TIMEOUT_MS=120000
MODEL_MAX_OUTPUT_TOKENS=32000
MODEL_EVIDENCE_MAX_CHUNKS=128
MODEL_EVIDENCE_MAX_CHARS=120000
# Complete evidence is retained; Gemini reads approved image references directly.
MANUAL_IMAGE_TRANSPORT=gcs
MANUAL_IMAGE_CACHE_BYTES=268435456
MANUAL_CORPUS_VERSION=1
MANUAL_INVENTORY_CACHE_SECONDS=30
MANUAL_COVERAGE_REVIEW_ENABLED=false
REQUEST_TIMEOUT_SECONDS=500
RETRIEVAL_CACHE_TTL_SECONDS=900

# BigQuery export remains disabled unless separately authorized.
BQ_API_LOGGING_ENABLED=false
API_TIMING_DEBUG=false
API_LOG_TABLE=api_call_logs
API_LOG_RETENTION_DAYS=30
API_LOG_QUEUE_SIZE=1000
API_LOG_BATCH_SIZE=20
API_LOG_FLUSH_SECONDS=2
# Optional dedicated BigQuery writer credentials (never commit this file).
API_LOG_CREDENTIALS_FILE=
# Optional private stable HMAC key; generated per process if omitted.
API_LOG_HASH_KEY=
